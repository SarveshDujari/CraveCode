{
  "name": "mealpilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && tsup src/server/index.ts --format esm --platform node --out-dir dist-server --no-splitting",
    "start": "node dist-server/index.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check": "tsc --noEmit",
    "gemma:probe": "tsx src/server/gemma-probe.ts",
    "gemma:evaluate": "tsx src/server/gemma-evaluate.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.79.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@sentry/node": "^11.8.0",
    "dotenv": "^18.0.8",
    "mongodb": "^7.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
